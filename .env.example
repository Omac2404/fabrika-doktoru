# SMTP — iletişim formu e-posta gönderimi (Nodemailer)
# Hosting panelinizdeki info@fabrikadoktoru.com.tr hesabının bilgileri
SMTP_HOST=mail.fabrikadoktoru.com.tr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@fabrikadoktoru.com.tr
SMTP_PASS=

# Formun gönderileceği adres (genelde info@... ile aynı)
CONTACT_TO=info@fabrikadoktoru.com.tr
